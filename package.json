{
  "name": "pull-video",
  "version": "1.2.1",
  "description": "PULL — загрузка видео и поиск потоков в браузере",
  "main": "src/main.cjs",
  "author": "Cveloy",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "icons": "electron scripts/make-icons.cjs",
    "dist": "node scripts/build-windows.cjs",
    "setup": "node scripts/build-windows.cjs",
    "pack": "node scripts/build-windows.cjs --dir"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "app.pull.video",
    "productName": "PULL",
    "copyright": "by Cveloy",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "installer/windows/PULL-UpdateWindow.exe",
        "to": "PULL-UpdateWindow.exe"
      },
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "*.exe",
          "*.txt",
          "*.md",
          "*.version",
          "ffmpeg-licenses/**/*"
        ]
      },
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/pull.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "PULL-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PULL",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "src/assets/pull.ico",
      "uninstallerIcon": "src/assets/pull.ico",
      "include": "installer/windows/installer.nsh",
      "installerHeader": "installer/windows/header.bmp",
      "installerSidebar": "installer/windows/sidebar.bmp",
      "uninstallDisplayName": "PULL",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cveloy102",
        "repo": "pull-video-downloader",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
