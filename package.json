{
  "name": "pull-video",
  "version": "1.0.0",
  "description": "PULL — загрузка видео и поиск потоков в браузере",
  "main": "src/main.cjs",
  "author": "PULL",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win portable --x64",
    "pack": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "app.pull.video",
    "productName": "PULL",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "tools", "to": "tools", "filter": ["*.exe", "*.txt", "*.md", "*.version", "ffmpeg-licenses/**/*"] },
      { "from": "extension", "to": "extension" },
      { "from": "THIRD-PARTY-NOTICES.md", "to": "THIRD-PARTY-NOTICES.md" }
    ],
    "win": { "target": "portable", "icon": "src/assets/pull.ico", "signAndEditExecutable": true },
    "portable": { "artifactName": "PULL-${version}-portable.exe" }
  }
}
