{
  "name": "pull-video",
  "version": "1.1.0",
  "description": "PULL — загрузка видео и поиск потоков в браузере",
  "main": "src/main.cjs",
  "author": "Cveloy",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "icons": "electron scripts/make-icons.cjs",
    "dist": "electron-builder --win nsis portable --x64",
    "setup": "electron-builder --win nsis --x64",
    "pack": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "app.pull.video",
    "productName": "PULL",
    "copyright": "by Cveloy",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "tools", "to": "tools", "filter": ["*.exe", "*.txt", "*.md", "*.version", "ffmpeg-licenses/**/*"] },
      { "from": "extension", "to": "extension" },
      { "from": "THIRD-PARTY-NOTICES.md", "to": "THIRD-PARTY-NOTICES.md" }
    ],
    "win": { "target": ["nsis", "portable"], "icon": "src/assets/pull.ico", "signAndEditExecutable": true },
    "nsis": {
      "artifactName": "PULL-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PULL",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "src/assets/pull.ico",
      "uninstallerIcon": "src/assets/pull.ico",
      "installerHeaderIcon": "src/assets/pull.ico",
      "uninstallDisplayName": "PULL",
      "installerLanguages": ["ru_RU"],
      "language": "1049"
    },
    "portable": { "artifactName": "PULL-${version}-portable.exe" }
  }
}
